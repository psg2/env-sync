{
	"name": "@psg2/env-sync",
	"version": "0.0.0",
	"description": "Declarative env var management — 1Password → local files, Vercel, GitHub secrets",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"env-sync": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsx src/cli.ts",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"format:check": "biome format src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm build"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/psg2/env-sync.git"
	},
	"homepage": "https://github.com/psg2/env-sync#readme",
	"bugs": {
		"url": "https://github.com/psg2/env-sync/issues"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"keywords": [
		"env",
		"environment",
		"secrets",
		"1password",
		"vercel",
		"github",
		"dotenv",
		"sync"
	],
	"license": "MIT",
	"dependencies": {
		"yaml": "^2.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@types/node": "^24",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^7",
		"vitest": "^5.0.0"
	}
}
